<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/cart.css">
</head>
<body>
<header class="header">
    <button class="menu-toggle" id="menuBtn" type="button">
        <span></span><span></span><span></span>
    </button>
    <a href="/" class="logo">FOODIE</a>
    <span class="category-label" id="currentCategory"><%= label %></span>
    <div class="header-icons">
        <span class="search-link">🔍</span>
        <a href="/cart" class="cart-link">🛒 <span class="cart-count" id="cartCount">0</span></a>
    </div>
</header>
<div class="main-container">
    <aside class="sidebar" id="sidebar">
        <nav class="category-nav">
            <ul id="categoryList">
                <% categories.forEach(function(cat){ %>
                    <li><button class="cat-btn" data-id="<%= cat.id %>"><%= cat.name %></button></li>
                <% }) %>
            </ul>
        </nav>
        <div class="sidebar-footer">
            <a href="#">Contact</a>
            <a href="#">Newsletter</a>
            <a href="#">Subscribe</a>
        </div>
    </aside>